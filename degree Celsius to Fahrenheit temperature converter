#include <iostream>
using namespace std;
 double fahrenheit(double quantity);

int main() {
    double quantity;
    cout << "please enter the degree in celcius: ";
    cin >> quantity;

    cout<< "the amount in Fahrenheit temperature is: " << fahrenheit(quantity)<<"°" << endl;
    if (fahrenheit(quantity) >= 100){
        cout << "it's above threshold.";
    }
    return 0;
}
double fahrenheit(double quantity){
    return (quantity*9/5)+32;
}
